# ============================================================
# Semester — .gitignore
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ── Frontend & API builds ────────────────────────────────────
dist/
build/
dist-installers/
api-node/dist/
api-node/*.html
api-node/test-*.js
frontend/dist/
frontend/dev-dist/
frontend/public/version.json

# ── Environment & Secrets ────────────────────────────────────
.env
.env.*
!.env.example
**/.env
!**/.env.example
*.jks
*.keystore
google-services.json

# ── Local SQLite Databases & Backups ─────────────────────────
*.db
*.db-wal
*.db-shm
safety_backups/

# ── Rust & Tauri Builds ──────────────────────────────────────
target/
**/target/

# ── Android & Gradle Builds ──────────────────────────────────
.gradle/
**/.gradle/
**/build/
local.properties
**/local.properties
*.apk
*.aab
*.so

# ── Logs, Temp & User Exports ────────────────────────────────
logs/
*.log
*.pdf
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.backup

# ── IDEs & OS ────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.idea/
*.iml
*.iws
*.ipr
.cursorignore
.cursorindexingignore
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
