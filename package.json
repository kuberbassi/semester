{
  "name": "semester",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "api-node",
    "frontend"
  ],
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix api-node\" \"node scripts/wait-for-api.mjs && npm run dev --prefix frontend\"",
    "dev": "npm start",
    "api": "npm run dev --prefix api-node",
    "web": "npm run dev --prefix frontend",
    "build": "npm run build --workspace api-node && npm run build --workspace frontend",
    "lint": "npm run lint --workspace api-node && npm run lint --workspace frontend",
    "lint:api": "npm run lint --workspace api-node",
    "lint:frontend": "npm run lint --workspace frontend",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/quality.test.ts",
    "quality": "npm run lint && npm run test:unit && npm run build",
    "typecheck": "npm run build",
    "smoke:api": "npm run smoke:api --workspace api-node",
    "android:setup": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 setup",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 build",
    "android:run": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 run",
    "android:run:ui": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 run -SkipRust",
    "android:logs": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 logs",
    "android:crash": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 crash",
    "android:smoke": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 smoke",
    "android:wireless": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 wireless",
    "android:mirror": "powershell -ExecutionPolicy Bypass -File scripts/android-dev.ps1 mirror"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
